PORT=4000
CORS_ORIGIN=http://localhost:3000
# Only used by "npm run import:local" to read the old JSON files
DATA_DIR=data
# Admin panel login (used to create the account on first start)
ADMIN_EMAIL=admin@kripty.studio
ADMIN_PASSWORD=change-me-to-a-long-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
UPLOADS_DIR=uploads
# Public base URL of this API (used to build image URLs)
PUBLIC_API_URL=http://localhost:4000
# Frontend revalidation hook so content edits show up instantly
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=
# Visitor analytics
# Set to the number of proxies in front of the API (e.g. 1) so the real visitor IP is used
TRUST_PROXY=
# Store full visitor IPs (default: last IPv4 octet / IPv6 tail removed)
TRACK_FULL_IP=false
# Delete visitors not seen for this many days
TRACK_RETENTION_DAYS=395

# MongoDB Atlas (copy from atlas-credentials.env)
MONGODB_URI=
MONGODB_DB=kripty
